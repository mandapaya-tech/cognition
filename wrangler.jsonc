{
  "name": "cognition",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "account_id": "eba2cb1f5cba687405149463c8f94383",
  // public/ se genera con scripts/build.sh (solo archivos del sitio).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "vars": {
    "PARTNER_ID": "p01",
    "GC_PRICE_50": "price_1URKi5DtcYGFLbuPVV4wOB5l",
    "GC_PRICE_75": "price_1URKi6DtcYGFLbuPirLP2v61",
    "GC_PRICE_100": "price_1URKi7DtcYGFLbuPvuaQVZwn"
  },
  "durable_objects": { "bindings": [{ "name": "PARTNER_HUB", "class_name": "PartnerHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartnerHub"] }]
  // Secretos: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PARTNER_HMAC_SECRET; opcional PARTNER_WEBHOOK_URL.
}
